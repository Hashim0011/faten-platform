{
  "name": "faten-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --port 4173",
    "build": "vite build",
    "build:analyze": "vite build --mode production && ls -lh dist/assets",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 254",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . -f json -o reports/eslint-report.json || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:deps": "npm audit --audit-level=high",
    "sbom": "cyclonedx-npm --output-format JSON --output-file sbom.json --omit dev",
    "validate": "run-s typecheck lint format:check test",
    "prepare": "husky",
    "sonar": "node scripts/sonar.mjs",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down",
    "sonar:logs": "docker compose -f docker-compose.sonar.yml logs -f sonarqube"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.344.0",
    "openai": "^6.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cyclonedx/cyclonedx-npm": "^1.20.0",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sonarqube-scanner": "^4.4.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9",
    "vitest-sonar-reporter": "^2.0.4"
  },
  "description": "فطن — منصة الأمن الفكري",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
