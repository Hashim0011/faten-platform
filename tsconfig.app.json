{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* ─── سلامة الأنواع: بوابة صارمة في CI عند صفر أخطاء ─── */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* ─── الكود الميت: يُدار عبر ESLint كتحذيرات بسقف متناقص ───
       السبب: هذه ليست أخطاء سلامة أنواع، وتعطيلها هنا يمنع
       حجب البايب لاين على دين تقني موروث. راجع eslint.config.js */
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    /* ─── أنواع الاختبارات ─── */
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "tests"]
}
