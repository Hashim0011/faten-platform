# =============================================
# Faten Project - Environment Variables
# =============================================

# Supabase Configuration
# احصل على هذه القيم من لوحة تحكم Supabase الخاصة بك
# https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=your_supabase_project_url_here
# مثال: https://xxxxxxxxxxxxx.supabase.co

VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# مثال: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================
# AI Chatbot - Google Gemini API Configuration (FREE!)
# =============================================

VITE_GEMINI_API_KEY=your_gemini_api_key_here
# احصل على مفتاح API من: https://aistudio.google.com/app/apikey
# مثال: AIzaSyxxxxxxxxxxxxx

# ملاحظات:
# 1. قم بإنشاء حساب Google (مجاني)
# 2. احصل على API Key من Google AI Studio
# 3. الصق المفتاح هنا
# 4. المستوى المجاني يوفر: 15 طلب/دقيقة، 1 مليون token/يوم

# =============================================
# AI Chatbot - Anthropic Claude (OPTIONAL - requires billing)
# =============================================
# VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# احصل عليه من: https://console.anthropic.com/

# =============================================
# AI Chatbot - n8n Webhook Configuration (DEPRECATED)
# =============================================
# VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/REDACTED

# =============================================
# تعليمات الإعداد
# =============================================
# 1. انسخ هذا الملف إلى .env (بدون .example)
# 2. املأ القيم الحقيقية من Supabase و n8n
# 3. لا تشارك ملف .env مع أحد (سري!)
# 4. راجع CHATBOT_SETUP_GUIDE.md للتعليمات الكاملة
