# ═══════════════════════════════════════════════════════════
#  فطن — قالب متغيرات البيئة
#
#  الاستخدام:  cp .env.example .env  ثم املأ القيم الحقيقية
#  ⚠️  ملف .env مُتجاهَل في Git ولا يُرفع أبداً.
#      في CI/CD تُحقن هذه القيم من GitHub Secrets.
# ═══════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────
# من: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── OpenAI (المساعد الذكي) ────────────────────────────────
# ⚠️  تحذير معماري: هذا المفتاح يُحمَّل في المتصفح حالياً
#     (dangerouslyAllowBrowser). الحل الصحيح: نقل الاستدعاء
#     إلى Serverless Function. مسجَّل كدين تقني.
VITE_OPENAI_API_KEY=sk-proj-your-openai-key

# ── n8n Webhook ────────────────────────────────────────────
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-webhook-id
VITE_N8N_PROXY_TARGET=https://your-n8n-instance
VITE_N8N_PROXY_PATH=/webhook-test/your-webhook-id
